    {
      "dot": "cyan",
      "title": "Session facade",
      "items": [
        "session.prompt() runs slash-command check, input handlers, skill/template expand",
        "Validates model + auth, may pre-inject compaction before the new turn",
        "before_agent_start extensions can edit system prompt and tool loadout"
      ]
    },
    {
      "dot": "emerald",
      "title": "Agent loop (pi-agent-core)",
      "items": [
        "declareToolChanges emits a system message for added/removed tools",
        "prepareRequest projects context (compaction + virtual model resolution)",
        "streamAssistantResponse consumes the stream until the assistant message ends"
      ]
    },
    {
      "dot": "violet",
      "title": "LLM call",
      "items": [
        "streamFn is modelRuntime.streamSimple, set in core/sdk.ts createAgentSession",
        "Resolves auth.json credential, applies provider attribution headers",
        "Returns AsyncIterable of AssistantMessageEvent with a final AssistantMessage"
      ]
    },
    {
      "dot": "amber",
      "title": "Tool execution + events",
      "items": [
        "executeToolCalls runs prepared tools; nested calls go through the same pipeline",
        "beforeToolCall / afterToolCall let extensions observe or rewrite results",
        "Agent emits AgentEvent stream the session forwards to subscribed run modes"
      ]
    }
  ]
