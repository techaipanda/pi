  "cards": [
    {
      "dot": "cyan",
      "title": "Boot (main.ts)",
      "items": [
        "cli.ts is the bin entry; calls main(process.argv.slice(2))",
        "main() runs parseArgs(args) and runMigrations(cwd) up front",
        "Auth / package / config / mcp subcommands exit early before this path"
      ]
    },
    {
      "dot": "emerald",
      "title": "Assemble",
      "items": [
        "createSessionManager opens or creates the JSONL session for the resolved cwd",
        "createAgentSessionRuntime wraps a factory that builds cwd-bound services",
        "Services are ModelRuntime, SettingsManager, DefaultResourceLoader (extensions/skills/themes)"
      ]
    },
    {
      "dot": "violet",
      "title": "Build Session",
      "items": [
        "createAgentSession() in core/sdk.ts builds Agent with streamFn = modelRuntime.streamSimple",
        "Wraps Agent in AgentSession; wires prepareRequest / NextTurn / finishTurn hooks",
        "Returns AgentSessionRuntime holding the session + cwd-bound services"
      ]
    },
    {
      "dot": "amber",
      "title": "Dispatch",
      "items": [
        "resolveAppMode picks rpc / interactive / print / json",
        "Each mode owns only its I/O layer; all share the same AgentSession",
        "Mode subscribes to session events and renders or forwards them"
      ]
    }
  ]
